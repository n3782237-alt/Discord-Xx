{
  "name": "discord-x-desktop",
  "version": "1.0.0",
  "description": "Discord X desktop client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "build": {
    "appId": "com.discordx.desktop",
    "productName": "Discord X",
    "files": ["main.js", "preload.js", "renderer/**/*", "node_modules/**/*"],
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
